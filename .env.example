# Copy to backend/.env (or export in your shell). Placeholders only — never commit real values.

# development | test | production. Production refuses the built-in development keys.
APP_ENV=development

# PostgreSQL (recommended). For a zero-setup local run you can use SQLite instead:
#   DATABASE_URL=sqlite:///./apaar-dev.db
DATABASE_URL=postgresql+psycopg://apaar:apaar_dev_password@localhost:5432/apaar

# Keys protecting APAAR identifiers at rest. Leave unset in development to use the public
# built-in dev keys (synthetic data only). Generate real values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                        # HMAC key
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  # Fernet key
# IDENTIFIER_HMAC_KEY=
# IDENTIFIER_ENCRYPTION_KEY=

# Must be true when served over HTTPS (required in production).
COOKIE_SECURE=false
SESSION_TTL_MINUTES=480

# Only needed if the UI is served from a different origin than the API (not the default).
# CORS_ORIGINS=["http://localhost:5173"]

UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_ROWS=5000
